---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogLayout.astro";
import { getReadingTimeMinutes } from "src/utils/readingTime";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts
		.filter((post) => !post.id.startsWith("_"))
		.map((post) => ({
			params: { slug: post.id },
			props: post,
		}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = getReadingTimeMinutes(post.body);
---

<BlogPost post={post.data} headings={headings} readingMinutes={readingMinutes}>
	<Content />
</BlogPost>
