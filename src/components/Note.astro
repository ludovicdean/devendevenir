---
type NoteVariant = "tip" | "warning" | "info" | "junior";

interface Props {
    type?: NoteVariant;
    title?: string;
}

const labels: Record<NoteVariant, string> = {
    tip: "Astuce",
    warning: "Attention",
    info: "Note",
    junior: "Pour les juniors",
};

const { type = "info", title = labels[type] } = Astro.props;

const styles: Record<NoteVariant, string> = {
    tip: "border-[var(--brand)] bg-yellow-50 dark:bg-yellow-400/10",
    warning: "border-amber-600 bg-amber-50 dark:bg-amber-500/10",
    info: "border-[var(--accent)] bg-neutral-50 dark:bg-zinc-800/60",
    junior: "border-sky-500 bg-sky-50 dark:bg-sky-500/10",
};
---

<aside
    class:list={[
        "my-8 rounded-r-lg border-l-4 px-4 py-3 text-[0.95em] leading-relaxed",
        styles[type],
    ]}
    data-testid={`note-${type}`}
>
    <p class="mb-2 font-bold text-[var(--color-heading)]">{title}</p>
    <div class="note-body text-[var(--color-text)] [&_p:last-child]:mb-0">
        <slot />
    </div>
</aside>
