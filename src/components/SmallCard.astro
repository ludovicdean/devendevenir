---
import { Image } from "astro:assets";
import { getUrl } from "@utils/blogUtils";

const { post, dataTestId, ...props } = Astro.props;
---

<li {...props} class="relative w-full md:w-[calc(33%-0.5rem)] h-64 list-none">
    <a
        href={getUrl(post)}
        class="no-underline block h-full"
        target={post.data.url ? "_blank" : "_self"}
        rel={post.data.url ? "noreferrer" : undefined}
    >
        <div class="relative h-full w-full overflow-hidden">
            <Image
                src={post.data.banner}
                class="h-full w-full object-cover"
                alt={post.data.title}
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
            />
            <div
                class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-2/3 bg-slate-900 bg-opacity-50 flex items-center justify-center"
            >
                <p
                    class="text-white text-2xl font-bold py-1 px-2 text-center w-full mb-0 hover:text-yellow-400"
                >
                    {post.data.title}
                </p>
            </div>
        </div>
    </a>
</li>
