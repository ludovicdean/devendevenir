---
const base = import.meta.env.BASE_URL;
const { tags } = Astro.props;
---

<div class="pb-6 flex flex-wrap">
    {
        tags.map((tag, index) => (
            <span
                class="inline-flex items-center justify-center text-lg rounded-xl mx-2 px-4 my-2 bg-gradient-to-r from-[var(--chrome-from)] to-[var(--chrome-to)] hover:animate-pulse"
            >
                <a
                    href={`${base + "/tags/" + tag.id}/`}
                    class="justify-center no-underline text-white font-bold hover:text-[var(--brand)]"
                    data-test-id={`tag-${index}`}
                >
                    {tag.name}
                    <span
                        class="text-[var(--brand)]"
                        data-test-id={`count-${index}`}
                    >
                        {tag.count}
                    </span>
                </a>
            </span>
        ))
    }
</div>
